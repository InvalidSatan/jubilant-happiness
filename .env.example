# =============================================================================
# Octagon Woodshop Log — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before starting the app.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Flask — REQUIRED for production
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PRODUCTION (PostgreSQL — recommended):
DATABASE_URL=postgresql://woodshop:CHANGE_THIS_PASSWORD@localhost:5432/woodshop_log

# DEVELOPMENT (SQLite — single-user only, not recommended for production):
# DATABASE_URL=sqlite:///instance/woodshop.db

# PostgreSQL connection-pool tuning (production only, defaults shown):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Server settings (used by start.sh)
# ---------------------------------------------------------------------------
PORT=8080
WORKERS=2

# Timezone for displaying timestamps (stored internally as UTC).
# Any IANA name, e.g. America/New_York, America/Chicago, America/Denver.
# DISPLAY_TIMEZONE=America/New_York

# ---------------------------------------------------------------------------
# Banner SIS Integration (optional — deferred)
# ---------------------------------------------------------------------------
# BANNER_API_URL=https://banner.appstate.edu/api
# BANNER_API_KEY=

# ---------------------------------------------------------------------------
# ASULearn / Moodle Integration (optional — deferred)
# ---------------------------------------------------------------------------
# ASULEARN_API_URL=https://asulearn.appstate.edu/webservice/rest/server.php
# ASULEARN_API_TOKEN=

# ---------------------------------------------------------------------------
# Canvas LMS Integration (optional)
# ---------------------------------------------------------------------------
# Generate a token under Canvas > Account > Settings > Approved Integrations.
# CANVAS_API_URL=https://appstate.instructure.com/api/v1
# CANVAS_API_TOKEN=

# ---------------------------------------------------------------------------
# Course → equipment mapping (optional)
# ---------------------------------------------------------------------------
# JSON object mapping external course identifiers (Banner course codes,
# ASULearn course names, or Canvas course_code / sis_course_id) to equipment
# names exactly as they appear in the app. Used by the "Sync External" /
# "Sync All Students" actions to auto-grant training. Until this is set,
# syncing succeeds but grants nothing.
# COURSE_EQUIPMENT_MAP_JSON={"ART 2210": "Welding", "SHOP_SAFETY_101": "Basic Woodshop"}
