# =============================================================================
# Octagon Log — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before starting the app.
#   cp .env.example .env
#
# Every value here is read with os.getenv() at startup and has no secret
# default, so a containerized deployment can skip the .env file entirely and
# inject these as environment variables instead. Never commit a filled-in .env.

# ---------------------------------------------------------------------------
# Flask — REQUIRED for production
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PRODUCTION (MySQL Galera cluster):
DATABASE_URL=mysql://octagon:CHANGE_THIS_PASSWORD@galera.its.appstate.edu:3306/octagon_log

# The app rewrites mysql:// to mysql+pymysql:// at startup (SQLAlchemy would
# otherwise reach for the MySQLdb C extension) and appends ?charset=utf8mb4
# unless you set a charset yourself. Writing mysql+pymysql:// also works.
#
# Point this at a single writer node or the load balancer's single-writer VIP.
# Spreading writes across Galera nodes causes commit-time deadlock errors.
#
# For a TLS-required connection, append the CA path:
# DATABASE_URL=mysql://octagon:PASSWORD@host:3306/octagon_log?ssl_ca=/etc/ssl/certs/ca-certificates.crt

# DEVELOPMENT (SQLite — single-user only, not for production):
# DATABASE_URL=sqlite:///instance/woodshop.db

# MySQL connection-pool tuning (production only, defaults shown).
# Keep DB_POOL_RECYCLE below the cluster's wait_timeout and the load
# balancer's idle timeout, or the pool will hand out dead connections.
# The pool is per process — N workers × N containers multiplies these.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Server settings (used by start.sh)
# ---------------------------------------------------------------------------
PORT=8080
WORKERS=2

# ---------------------------------------------------------------------------
# Banner SIS Integration (optional — deferred)
# ---------------------------------------------------------------------------
# BANNER_API_URL=https://banner.appstate.edu/api
# BANNER_API_KEY=

# ---------------------------------------------------------------------------
# ASULearn / Moodle Integration (optional — deferred)
# ---------------------------------------------------------------------------
# ASULEARN_API_URL=https://asulearn.appstate.edu/webservice/rest/server.php
# ASULEARN_API_TOKEN=

# ---------------------------------------------------------------------------
# Canvas LMS Integration (optional — stub)
# ---------------------------------------------------------------------------
# Generate a token under Canvas > Account > Settings > Approved Integrations.
# CANVAS_API_URL=https://appstate.instructure.com/api/v1
# CANVAS_API_TOKEN=

# ---------------------------------------------------------------------------
# Google Calendar — monitor shift schedules (optional — placeholder)
# ---------------------------------------------------------------------------
# Only the credential lives here. Which calendar backs each shop area is set
# by faculty in the portal (Faculty > Shift Calendars) and stored in the
# database, since they create and own those calendars.
#
# Create an API key at console.cloud.google.com with the Calendar API enabled.
# NOTE: an API key can only read PUBLIC calendars. Reading a private shop
# calendar needs a service account instead — pending a decision.
# GOOGLE_CALENDAR_API_KEY=
#
# How many area cards the dashboard shows (default 3):
# GOOGLE_CALENDAR_CARD_COUNT=3
