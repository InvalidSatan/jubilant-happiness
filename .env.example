# =============================================================================
# Octagon Log — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values before starting the app.
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Flask — REQUIRED for production
# ---------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PRODUCTION (PostgreSQL — recommended):
DATABASE_URL=postgresql://woodshop:CHANGE_THIS_PASSWORD@localhost:5432/woodshop_log

# DEVELOPMENT (SQLite — single-user only, not recommended for production):
# DATABASE_URL=sqlite:///instance/woodshop.db

# PostgreSQL connection-pool tuning (production only, defaults shown):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800

# ---------------------------------------------------------------------------
# Server settings (used by start.sh)
# ---------------------------------------------------------------------------
PORT=8080
WORKERS=2

# Number of reverse proxies in front of the app (production only). 1 matches
# the Nginx setup in DEPLOYMENT.md; use 2 if a load balancer sits in front of
# that proxy. Do not set it higher than the number of proxies you actually
# run — a client could then forge its own address via X-Forwarded-For.
# PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Banner SIS Integration (optional — deferred)
# ---------------------------------------------------------------------------
# BANNER_API_URL=https://banner.appstate.edu/api
# BANNER_API_KEY=

# ---------------------------------------------------------------------------
# ASULearn / Moodle Integration (optional — deferred)
# ---------------------------------------------------------------------------
# ASULEARN_API_URL=https://asulearn.appstate.edu/webservice/rest/server.php
# ASULEARN_API_TOKEN=

# ---------------------------------------------------------------------------
# Canvas LMS Integration (optional — stub)
# ---------------------------------------------------------------------------
# Generate a token under Canvas > Account > Settings > Approved Integrations.
# CANVAS_API_URL=https://appstate.instructure.com/api/v1
# CANVAS_API_TOKEN=

# ---------------------------------------------------------------------------
# Google Calendar — monitor shift schedules (optional — placeholder)
# ---------------------------------------------------------------------------
# Only the credential lives here. Which calendar backs each shop area is set
# by faculty in the portal (Faculty > Shift Calendars) and stored in the
# database, since they create and own those calendars.
#
# Create an API key at console.cloud.google.com with the Calendar API enabled.
# NOTE: an API key can only read PUBLIC calendars. Reading a private shop
# calendar needs a service account instead — pending a decision.
# GOOGLE_CALENDAR_API_KEY=
#
# How many area cards the dashboard shows (default 3):
# GOOGLE_CALENDAR_CARD_COUNT=3
